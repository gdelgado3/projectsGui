import base64
import json
import mimetypes
import sys

from anthropic import Anthropic
from dotenv import load_dotenv

from src.prompts import VISION_PROMPT

load_dotenv()

MODEL = "claude-sonnet-5"

client = Anthropic()


def analisar_imagem(caminho_imagem: str) -> dict:
    with open(caminho_imagem, "rb") as f:
        imagem_bytes = f.read()

    media_type = mimetypes.guess_type(caminho_imagem)[0] or "image/jpeg"
    imagem_base64 = base64.standard_b64encode(imagem_bytes).decode("utf-8")

    resposta = client.messages.create(
        model=MODEL,
        max_tokens=1024,
        messages=[
            {
                "role": "user",
                "content": [
                    {
                        "type": "image",
                        "source": {
                            "type": "base64",
                            "media_type": media_type,
                            "data": imagem_base64,
                        },
                    },
                    {"type": "text", "text": VISION_PROMPT},
                ],
            }
        ],
    )

    texto = resposta.content[0].text.strip()

    # o modelo por vezes envolve o JSON em ```json ... ``` apesar do prompt
    # pedir para não o fazer — removemos isso antes de tentar interpretar
    if texto.startswith("```"):
        texto = texto.strip("`").removeprefix("json").strip()

    try:
        return json.loads(texto)
    except json.JSONDecodeError:
        print(texto)
        return None


if __name__ == "__main__":
    caminho = sys.argv[1]
    resultado = analisar_imagem(caminho)
    if resultado is None:
        print("ERRO a dar parsing do JSON")
    else:
        print(json.dumps(resultado, indent=2, ensure_ascii=False))
